RewriteEngine On

# The Turkish site moved to its own domain (see SITE_CONFIG.turkishSiteUrl).
# Every former /tr/... URL is redirected there permanently, keeping the slug.
# A URL move only: no redirect by browser language or IP address — visitors
# choose the country via the footer link, crawlers are never redirected.
# Deploy this rule only once https://softlyx.tr/ answers (SITE_CONFIG.turkishSiteUrl
# is set in the same commit): a 301 is cached by browsers, so the target must exist.
RewriteRule ^tr(?:/(.*))?$ https://softlyx.tr/$1 [R=301,L,NC]

# The Turkish web-app manifest sits in the document root, so the rule above does
# not catch it: that one only matches the path "tr". The file was removed from
# the repository with the locale, but the deploy mirrors without --delete, so the
# server still had it and served it with 200. Its counterpart on the Turkish
# domain is called manifest.json, hence a rule of its own rather than a wider
# pattern. Anchored on the full filename so manifest.json and manifest.en.json
# stay untouched.
#
# Two things to know before touching this rule:
#  - The file is STILL on the server. It is only unreachable because of this
#    rule. Do not remove the rule before it has actually been deleted there,
#    or the stale Turkish manifest answers 200 again.
#  - The target lives in the softlyx.tr repository. Renaming manifest.json
#    there turns this 301 into a redirect to a 404, and nothing here would
#    notice. It belongs on the same check list as the /tr target above.
RewriteRule ^manifest\.tr\.json$ https://softlyx.tr/manifest.json [R=301,L]

# The site lives on https://softlyx.de since 2026-10-16 (SITE_CONFIG.baseUrl). The
# two softlyx.tr rules above come first, so a former /tr URL reaches softlyx.tr in
# one hop from every host.
#
# Domain move: ilhan-buenyamin.com, www.ilhan-buenyamin.com and www.softlyx.de go
# to the same path on https://softlyx.de. Only addresses that are NOT an existing
# file move: every page address is a prerendered directory (/, /en/, /blog/...) and
# moves; a path without its closing slash takes a second hop through DirectorySlash
# on softlyx.de. The index.html (and index.csr.html) behind a directory is a page,
# not a file a tab needs: it moves to its directory first — served on the old host
# it would run the new bundle, whose form posts across origins to softlyx.de and
# shows an error although the mail went out. Every other file stays reachable on
# the old host, on purpose:
#  - a tab still open on the old domain lazy-loads its chunks, calls /api/ and posts
#    its form to /send_mail/ on that host. Module imports and fetch run in CORS
#    mode, and a 301 to another host fails them (softlyx.de sends no CORS header),
#    so navigation would silently do nothing and the inquiry would never arrive;
#  - Search Console re-checks google*.html on the old property, which has to stay
#    verified for the change of address.
# The hosts are named rather than "anything but softlyx.de", so IONOS preview
# hostnames are not moved over HTTPS (over plain HTTP every host goes to softlyx.de).
# ilhan-buenyamin.com must stay registered and pointed at this folder: the mail
# address mail@ilhan-buenyamin.com still depends on it, and Google recommends
# keeping a moved site's redirects for at least a year.
# Before deploying a change here: https://softlyx.de/ must answer with a valid
# certificate — a 301 is cached by browsers, so the target must exist.
RewriteCond %{HTTP_HOST} ^(?:www\.)?ilhan-buenyamin\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.softlyx\.de$ [NC]
RewriteRule ^(.*/)?index(?:\.csr)?\.html$ https://softlyx.de/$1 [R=301,L]
# robots.txt and the sitemap describe the site, not files a tab needs: on the old
# hosts they move too, so the old property points crawlers at the new address.
RewriteCond %{HTTP_HOST} ^(?:www\.)?ilhan-buenyamin\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.softlyx\.de$ [NC]
RewriteRule ^(robots\.txt|sitemap\.xml)$ https://softlyx.de/$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{HTTP_HOST} ^(?:www\.)?ilhan-buenyamin\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.softlyx\.de$ [NC]
RewriteRule ^ https://softlyx.de%{REQUEST_URI} [R=301,L]

# Plain HTTP goes to HTTPS on softlyx.de, without exception: form data is never
# accepted unencrypted.
RewriteCond %{HTTPS} off
RewriteRule ^ https://softlyx.de%{REQUEST_URI} [R=301,L]

# Unknown paths: real 404 status with branded error page
ErrorDocument 404 /404/index.html

# Long-lived caching for hashed assets, always-fresh HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>
