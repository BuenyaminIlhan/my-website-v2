# Redirects: www -> non-www, HTTP -> HTTPS (301)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.ilhan-buenyamin\.com$ [NC]
RewriteRule (.*) https://ilhan-buenyamin.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule (.*) https://ilhan-buenyamin.com%{REQUEST_URI} [R=301,L]

# The Turkish site moved to its own domain (see SITE_CONFIG.turkishSiteUrl).
# Every former /tr/... URL is redirected there permanently, keeping the slug.
# A URL move only: no redirect by browser language or IP address — visitors
# choose the country via the footer link, crawlers are never redirected.
# Deploy this rule only once https://softlyx.tr/ answers (SITE_CONFIG.turkishSiteUrl
# is set in the same commit): a 301 is cached by browsers, so the target must exist.
RewriteRule ^tr(?:/(.*))?$ https://softlyx.tr/$1 [R=301,L,NC]

# The Turkish web-app manifest sits in the document root, so the rule above does
# not catch it: that one only matches the path "tr". The file was removed from
# the repository with the locale, but the deploy mirrors without --delete, so the
# server still had it and served it with 200. Its counterpart on the Turkish
# domain is called manifest.json, hence a rule of its own rather than a wider
# pattern. Anchored on the full filename so manifest.json and manifest.en.json
# stay untouched.
#
# Two things to know before touching this rule:
#  - The file is STILL on the server. It is only unreachable because of this
#    rule. Do not remove the rule before it has actually been deleted there,
#    or the stale Turkish manifest answers 200 again.
#  - The target lives in the softlyx.tr repository. Renaming manifest.json
#    there turns this 301 into a redirect to a 404, and nothing here would
#    notice. It belongs on the same check list as the /tr target above.
RewriteRule ^manifest\.tr\.json$ https://softlyx.tr/manifest.json [R=301,L]

# Unknown paths: real 404 status with branded error page
ErrorDocument 404 /404/index.html

# Long-lived caching for hashed assets, always-fresh HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>
